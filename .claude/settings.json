{
  "permissions": {
    "allow": [
      "Bash(npx vite build *)",
      "Bash(npx vite --port *)",
      "Bash(node tools/make-docs.mjs *)",
      "Bash(node tools/stuck-scan.mjs *)",
      "Bash(node tools/ship.mjs *)",
      "Bash(node tools/token-meter.mjs)",
      "Bash(node tools/token-meter.mjs *)",
      "Bash(node .claude/skills/play-test/harness.mjs *)",
      "Bash(curl -s -o /dev/null -w *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "deny": [
      "Read(public/data/*.json)",
      "Read(package-lock.json)",
      "Read(docs/REFERENCE.md)",
      "Read(docs/csv/**)",
      "Read(dist/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  }
}

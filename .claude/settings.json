{
  "permissions": {
    "allow": [
      "Bash(npx vite build *)",
      "Bash(npx vite --port *)",
      "Bash(node tools/make-docs.mjs *)",
      "Bash(node tools/stuck-scan.mjs *)",
      "Bash(node .claude/skills/play-test/harness.mjs *)",
      "Bash(curl -s -o /dev/null -w *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  }
}

var kind := ""
var weapon := ""
var color := Color.WHITE

func _init() -> void:
	custom_minimum_size = Vector2(64, 30)
	mouse_filter = Control.MOUSE_FILTER_IGNORE

func show_for(k: String, id: String, col: Color) -> void:
	var vis := k in ["wall_buy", "wall_ammo", "wall_full", "station", "station_full", "machine", "door"]
	if k == kind and id == weapon and col == color and visible == vis:
		return
	kind = k
	weapon = id
	color = col
	visible = vis
	queue_redraw()

func _draw() -> void:
	var sz := size
	match kind:
		"wall_buy", "wall_ammo", "wall_full":
			var pts: Array = SILHOUETTES.get(weapon, SILHOUETTES["rifle"])
			var minp := Vector2(INF, INF)
			var maxp := Vector2(-INF, -INF)
			for q: Array in pts:
				minp = minp.min(Vector2(q[0], q[1]))
				maxp = maxp.max(Vector2(q[0], q[1]))
			var k := minf(sz.x / (maxp.x - minp.x), sz.y / (maxp.y - minp.y)) * 0.95
			var off := (sz - (maxp - minp) * k) / 2.0 - minp * k
			var poly := PackedVector2Array()
			for q: Array in pts:
				poly.append(Vector2(q[0], q[1]) * k + off)
			var fill := color
			fill.a = 0.28
			if Geometry2D.triangulate_polygon(poly).size() > 0:
				draw_colored_polygon(poly, fill)
			poly.append(poly[0])
			draw_polyline(poly, color, 2.0, true)
			if kind != "wall_buy":
				_bullets(Vector2(sz.x - 14, sz.y - 12), 0.55)
		"station", "station_full":
			_bullets(Vector2(sz.x / 2.0 - 10, sz.y / 2.0 + 2), 1.0)
		"machine":
			var c := sz / 2.0
			for i in 8:
				var a := TAU * float(i) / 8.0
				draw_line(c + Vector2(cos(a), sin(a)) * 7.0, c + Vector2(cos(a), sin(a)) * 13.0, color, 4.0, true)
			draw_arc(c, 8.5, 0.0, TAU, 24, color, 3.0, true)
		"door":
			var r := Rect2(sz.x / 2.0 - 9, 2, 18, sz.y - 4)
			draw_rect(r, color, false, 2.0)
			draw_circle(Vector2(r.position.x + 13, sz.y / 2.0 + 2), 1.8, color)

## Three cartridges (brass case, copper tip) centred on c.
func _bullets(c: Vector2, s: float) -> void:
	for i in 3:
		var x := c.x + (float(i) - 1.0) * 9.0 * s
		var body := Rect2(x - 3.0 * s, c.y - 6.0 * s, 6.0 * s, 13.0 * s)
		draw_rect(body, Color(0.9, 0.7, 0.3))
		draw_colored_polygon(PackedVector2Array([Vector2(x - 3.0 * s, c.y - 6.0 * s), Vector2(x + 3.0 * s, c.y - 6.0 * s), Vector2(x, c.y - 12.0 * s)]), Color(0.8, 0.45, 0.25))
		draw_rect(Rect2(x - 3.4 * s, c.y + 6.0 * s, 6.8 * s, 2.0 * s), Color(0.6, 0.45, 0.2))
